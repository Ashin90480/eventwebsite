# --- Server ---
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/eventqr?retryWrites=true&w=majority

# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Exactly 64 hex chars (32 bytes). Used to encrypt QR tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QR_ENCRYPTION_KEY=change-me

# Comma-separated list of allowed frontend origins (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Public URL of the frontend, used in ticket e-mails and share links.
# Defaults to the first CLIENT_ORIGIN.
PUBLIC_APP_URL=http://localhost:5173

# Event times are interpreted in this zone
EVENT_TZ_OFFSET=+05:30
EVENT_TIMEZONE=Asia/Kolkata

# --- E-mail (QR ticket delivery). Leave SMTP_HOST empty to skip sending;
# registration still works and the ticket page shows the QR. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EventQR <no-reply@yourcollege.edu>

# Local development only. Ignored when NODE_ENV=production.
ENABLE_DEMO_LOGIN=true
DEMO_PASSWORD=Demo@12345
